{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hawiya:schema:template:1",
  "title": "Hawiya library template",
  "description": "One template (one choosable option) of one element, as stored in library/elements/<element>.json (R-060). Ready identities are not templates; they reference templates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "element", "kind", "name", "tags", "platforms", "metrics", "tokens", "a11y", "rtl", "source", "status"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "element": { "$ref": "#/$defs/element" },
    "kind": {
      "description": "numeric = generated from values/sliders; curated = picked from open libraries; composite = designed style with an HTML/CSS recipe; setting = simple option without a gallery.",
      "enum": ["numeric", "curated", "composite", "setting"]
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ar", "en"],
      "properties": {
        "ar": { "type": "string", "minLength": 1, "maxLength": 60 },
        "en": { "type": "string", "minLength": 1, "maxLength": 60 }
      }
    },
    "tags": {
      "type": "array",
      "items": { "$ref": "#/$defs/tag" },
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true
    },
    "platforms": {
      "type": "array",
      "items": { "enum": ["web", "desktop", "extension", "mobile"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "metrics": {
      "description": "Three 0..1 values used for matching: roundness, density, intensity.",
      "type": "object",
      "additionalProperties": false,
      "required": ["roundness", "density", "intensity"],
      "properties": {
        "roundness": { "type": "number", "minimum": 0, "maximum": 1 },
        "density": { "type": "number", "minimum": 0, "maximum": 1 },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "tokens": {
      "description": "Values in Design Tokens (DTCG) shape; checked in depth by the library checker (task 3.1).",
      "type": "object",
      "minProperties": 1
    },
    "extras": {
      "description": "Non-numeric additions, e.g. icon library and weight, chart options, font languages.",
      "type": "object"
    },
    "recipe": {
      "description": "Render recipe for composite templates (buttons, cards).",
      "type": "object",
      "additionalProperties": false,
      "required": ["html", "css"],
      "properties": {
        "html": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "css": { "type": "string", "minLength": 1, "maxLength": 20000 }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contrast", "reducedMotion"],
      "properties": {
        "contrast": { "description": "Contrast level the template meets with its intended colors; n/a when it has no text/background pair.", "enum": ["AA", "AAA", "n/a"] },
        "reducedMotion": { "description": "CSS alternative under prefers-reduced-motion, or null when the template has no motion.", "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "rtl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported"],
      "properties": {
        "supported": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "license"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "url": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 500 },
        "license": { "description": "SPDX-style identifier; the allow-list is checked by task 3.2.", "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,39}$" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["draft", "reviewed"] },
        "reviewedAt": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" }
      },
      "if": { "properties": { "state": { "const": "reviewed" } }, "required": ["state"] },
      "then": { "required": ["reviewedAt"] },
      "else": { "not": { "required": ["reviewedAt"] } }
    }
  },
  "if": { "properties": { "kind": { "const": "composite" } }, "required": ["kind"] },
  "then": { "required": ["recipe"] },
  "else": { "not": { "required": ["recipe"] } },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "maxLength": 64 },
    "element": {
      "description": "The elements that have templates (R-041..R-051). Ready identities (R-040) are stored separately.",
      "enum": ["colors", "modes", "fonts", "type-scale", "radius", "shadows", "icons", "buttons", "cards", "spacing", "direction"]
    },
    "tag": {
      "description": "The 16 fixed tags (project file, section 8).",
      "enum": ["minimal", "corporate", "editorial", "playful", "luxury", "glass", "brutalist", "neumorphic", "retro", "material", "cupertino", "fluent", "technical", "data-dense", "vivid", "soft"]
    }
  }
}
