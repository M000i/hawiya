{
  "about": "Shared server cases (plan.md section 6): the final contract of task 1.12. Every export body is a full bundle (bundle.build on tests/fixtures/identity/valid/<bundleIdentity>) written \"@bundle\", optionally edited by \"change\" (see tests/server/runner.js). The Python server runs the same list from task 1.14 on.",
  "fixtures": {
    "identity": "{\n  \"schemaVersion\": \"0.1-prototype\",\n  \"name\": \"T\"\n}\n",
    "design": "---\nversion: alpha\nname: \"T\"\ncolors:\n  primary: \"#2563eb\"\n---\n\n# T\n",
    "session": "{\n  \"type\": \"landing\",\n  \"language\": \"ar\",\n  \"tags\": [\"minimal\", \"corporate\"],\n  \"platform\": \"web\"\n}\n"
  },
  "cases": [
    {
      "name": "save succeeds: all six files written as sent, server closes with code 0",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": "@bundle",
          "expectStatus": 200
        }
      ],
      "expect": {
        "files": {
          "design/identity.json": "@bundle:identity.json",
          "design/DESIGN.md": "@bundle:DESIGN.md",
          "design/tokens.json": "@bundle:tokens.json",
          "design/tokens.css": "@bundle:tokens.css",
          "design/theme.css": "@bundle:theme.css",
          "design/style-guide.html": "@bundle:style-guide.html"
        },
        "exits": true,
        "exitCode": 0,
        "stdoutStatus": "saved",
        "written": [
          "identity.json",
          "DESIGN.md",
          "tokens.json",
          "tokens.css",
          "theme.css",
          "style-guide.html"
        ],
        "backup": null
      }
    },
    {
      "name": "save works without an Origin header (agent or curl, valid token)",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": "@bundle",
          "expectStatus": 200
        }
      ],
      "expect": {
        "files": {
          "design/identity.json": "@bundle:identity.json",
          "design/DESIGN.md": "@bundle:DESIGN.md",
          "design/tokens.json": "@bundle:tokens.json",
          "design/tokens.css": "@bundle:tokens.css",
          "design/theme.css": "@bundle:theme.css",
          "design/style-guide.html": "@bundle:style-guide.html"
        },
        "exits": true,
        "exitCode": 0
      }
    },
    {
      "name": "wrong token is rejected and nothing is written",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "not-the-token"
          },
          "body": "@bundle",
          "expectStatus": 401
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "missing token is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}"
          },
          "body": "@bundle",
          "expectStatus": 401
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "token in the query string is not accepted",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export?token={TOKEN}",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}"
          },
          "body": "@bundle",
          "expectStatus": 401
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "five wrong tokens close the server with code 1",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "wrong"
          },
          "body": "@bundle",
          "repeat": 5,
          "expectStatus": 401
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": true,
        "exitCode": 1,
        "stdoutStatus": "closed"
      }
    },
    {
      "name": "file name outside the allowed list is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": "@bundle",
          "expectStatus": 400,
          "change": [
            {
              "set": [
                "files",
                "evil.sh"
              ],
              "value": "echo pwned\n"
            },
            {
              "set": [
                "sha256",
                "evil.sh"
              ],
              "value": "x"
            }
          ],
          "expectBodyContains": "evil.sh"
        }
      ],
      "expect": {
        "absent": [
          "design",
          "evil.sh"
        ],
        "exits": false
      }
    },
    {
      "name": "path traversal in a file name is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": "@bundle",
          "expectStatus": 400,
          "change": [
            {
              "set": [
                "files",
                "../identity.json"
              ],
              "value": "{}\n"
            },
            {
              "set": [
                "sha256",
                "../identity.json"
              ],
              "value": "x"
            }
          ]
        }
      ],
      "expect": {
        "absent": [
          "design",
          "identity.json",
          "../identity.json"
        ],
        "exits": false
      }
    },
    {
      "name": "empty file list is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": {
            "files": {}
          },
          "expectStatus": 400
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "non-string file content is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": "@bundle",
          "expectStatus": 400,
          "change": [
            {
              "set": [
                "files",
                "DESIGN.md"
              ],
              "value": 5
            }
          ]
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "identity.json that is not valid JSON is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": "@bundle",
          "expectStatus": 400,
          "change": [
            {
              "set": [
                "files",
                "identity.json"
              ],
              "value": "{\n"
            },
            {
              "rehash": "identity.json"
            }
          ]
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "request body that is not JSON is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "bodyRaw": "files=identity.json",
          "expectStatus": 400
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "wrong content type is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "text/plain",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": "@bundle",
          "expectStatus": 415
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "oversized body is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "bodyFiller": 6000000,
          "expectStatus": 413
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "oversized chunked body (no Content-Length) is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "bodyFiller": 6000000,
          "chunked": true,
          "expectStatus": 413
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "a refused request's body is not read: server answers and closes the connection",
      "requests": [
        {
          "method": "POST",
          "path": "/somewhere",
          "hold": true,
          "expectStatus": 405,
          "expectServerCloses": true
        },
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "wrong"
          },
          "hold": true,
          "expectStatus": 401,
          "expectServerCloses": true
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "the unread body of a refused request is never handled as a second request (smuggling)",
      "requests": [
        {
          "method": "POST",
          "path": "/nope",
          "smuggle": true,
          "expectStatus": 405
        }
      ],
      "expect": {
        "exits": false
      }
    },
    {
      "name": "an HTTP/0.9 request never gets page content and does not stop the server",
      "requests": [
        {
          "raw": "GET /\r\n\r\n",
          "expectNotContains": "Hawiya",
          "maxResponses": 1
        },
        {
          "method": "GET",
          "path": "/",
          "expectStatus": 200
        }
      ],
      "expect": {
        "exits": false
      }
    },
    {
      "name": "smuggling: unknown Transfer-Encoding never yields a second response",
      "requests": [
        {
          "raw": "POST /nope HTTP/1.1\r\nHost: {HOST}\r\nConnection: keep-alive\r\nTransfer-Encoding: gzip\r\n\r\nGET / HTTP/1.1\r\nHost: {HOST}\r\n\r\n",
          "maxResponses": 1
        },
        {
          "method": "GET",
          "path": "/",
          "expectStatus": 200
        }
      ],
      "expect": {
        "exits": false
      }
    },
    {
      "name": "smuggling: two Content-Length headers never yield a second response",
      "requests": [
        {
          "raw": "POST /nope HTTP/1.1\r\nHost: {HOST}\r\nConnection: keep-alive\r\nContent-Length: 0\r\nContent-Length: {LEN_INNER}\r\n\r\nGET / HTTP/1.1\r\nHost: {HOST}\r\n\r\n",
          "maxResponses": 1
        }
      ],
      "expect": {
        "exits": false
      }
    },
    {
      "name": "smuggling: negative Content-Length never yields a second response",
      "requests": [
        {
          "raw": "POST /nope HTTP/1.1\r\nHost: {HOST}\r\nConnection: keep-alive\r\nContent-Length: -5\r\n\r\nGET / HTTP/1.1\r\nHost: {HOST}\r\n\r\n",
          "maxResponses": 1
        }
      ],
      "expect": {
        "exits": false
      }
    },
    {
      "name": "smuggling: Content-Length together with chunked never yields a second response",
      "requests": [
        {
          "raw": "POST /nope HTTP/1.1\r\nHost: {HOST}\r\nConnection: keep-alive\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\nGET / HTTP/1.1\r\nHost: {HOST}\r\n\r\n",
          "maxResponses": 1
        }
      ],
      "expect": {
        "exits": false
      }
    },
    {
      "name": "a malformed chunk size (0x1b) never saves anything",
      "requests": [
        {
          "raw": "POST /api/export HTTP/1.1\r\nHost: {HOST}\r\nX-Hawiya-Token: {TOKEN}\r\nContent-Type: application/json\r\nTransfer-Encoding: chunked\r\n\r\n0x1b\r\n{\"files\":{\"DESIGN.md\":\"x\"}}\r\n0\r\n\r\n",
          "maxResponses": 1
        }
      ],
      "expect": {
        "absent": [
          "design/DESIGN.md"
        ],
        "exits": false
      }
    },
    {
      "name": "TRACE and unknown methods are refused and the server keeps running",
      "requests": [
        {
          "method": "TRACE",
          "path": "/",
          "expectStatus": 405
        },
        {
          "raw": "FOO / HTTP/1.1\r\nHost: {HOST}\r\n\r\n",
          "maxResponses": 1
        },
        {
          "method": "GET",
          "path": "/",
          "expectStatus": 200
        }
      ],
      "expect": {
        "exits": false
      }
    },
    {
      "name": "identity.json with NaN is not valid JSON and is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "bodyRaw": "{\"files\":{\"identity.json\":\"{\\\"a\\\": NaN}\"}}",
          "expectStatus": 400
        },
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "bodyRaw": "{\"files\":{\"DESIGN.md\":\"x\"},\"n\":-Infinity}",
          "expectStatus": 400
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "a lone surrogate in file content is written as U+FFFD (valid UTF-8)",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": "@bundle",
          "change": [
            {
              "set": [
                "files",
                "DESIGN.md"
              ],
              "value": "a\ud800b\n"
            },
            {
              "rehash": "DESIGN.md"
            }
          ],
          "expectStatus": 200
        }
      ],
      "expect": {
        "files": {
          "design/DESIGN.md": "a\ufffdb\n"
        },
        "exits": true,
        "exitCode": 0
      }
    },
    {
      "name": "the server still exits after saving when the agent stopped reading its output",
      "closeStdoutAfterReady": true,
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": "@bundle",
          "expectStatus": 200
        }
      ],
      "expect": {
        "files": {
          "design/identity.json": "@bundle:identity.json",
          "design/DESIGN.md": "@bundle:DESIGN.md",
          "design/tokens.json": "@bundle:tokens.json",
          "design/tokens.css": "@bundle:tokens.css",
          "design/theme.css": "@bundle:theme.css",
          "design/style-guide.html": "@bundle:style-guide.html"
        },
        "exits": true,
        "exitCode": 0
      }
    },
    {
      "name": "the server still exits after five wrong tokens when the agent stopped reading its output",
      "closeStdoutAfterReady": true,
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "wrong"
          },
          "body": "@bundle",
          "repeat": 5,
          "expectStatus": 401
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": true
      }
    },
    {
      "name": "save completes and the server exits 0 even if the client resets the connection",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": "@bundle",
          "reset": true
        }
      ],
      "expect": {
        "files": {
          "design/identity.json": "@bundle:identity.json",
          "design/DESIGN.md": "@bundle:DESIGN.md",
          "design/tokens.json": "@bundle:tokens.json",
          "design/tokens.css": "@bundle:tokens.css",
          "design/theme.css": "@bundle:theme.css",
          "design/style-guide.html": "@bundle:style-guide.html"
        },
        "exits": true,
        "exitCode": 0,
        "stdoutStatus": "saved"
      }
    },
    {
      "name": "five wrong tokens close the server even if each connection is reset",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "wrong"
          },
          "body": "@bundle",
          "repeat": 5,
          "reset": true
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": true,
        "exitCode": 1,
        "stdoutStatus": "closed"
      }
    },
    {
      "name": "requests with a foreign Host do not keep an idle server alive",
      "args": [
        "--idle-timeout",
        "2"
      ],
      "requests": [
        {
          "method": "GET",
          "path": "/",
          "headers": {
            "Host": "evil.example"
          },
          "delayBeforeMs": 1500,
          "expectStatus": 403
        }
      ],
      "expect": {
        "exits": true,
        "exitCode": 1,
        "exitsWithinMsOfReady": 2800,
        "stdoutStatus": "closed"
      }
    },
    {
      "name": "export attempts from another site do not keep an idle server alive",
      "args": [
        "--idle-timeout",
        "2"
      ],
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "text/plain",
            "Origin": "https://evil.example"
          },
          "bodyRaw": "x",
          "delayBeforeMs": 1500,
          "expectStatus": 403
        }
      ],
      "expect": {
        "exits": true,
        "exitCode": 1,
        "exitsWithinMsOfReady": 2800,
        "stdoutStatus": "closed"
      }
    },
    {
      "name": "page loads marked cross-site do not keep an idle server alive",
      "args": [
        "--idle-timeout",
        "2"
      ],
      "requests": [
        {
          "method": "GET",
          "path": "/",
          "headers": {
            "Sec-Fetch-Site": "cross-site"
          },
          "delayBeforeMs": 1500,
          "expectStatus": 200
        }
      ],
      "expect": {
        "exits": true,
        "exitCode": 1,
        "exitsWithinMsOfReady": 2800,
        "stdoutStatus": "closed"
      }
    },
    {
      "name": "a normal page load does keep the server alive",
      "args": [
        "--idle-timeout",
        "2"
      ],
      "requests": [
        {
          "method": "GET",
          "path": "/",
          "headers": {
            "Sec-Fetch-Site": "none"
          },
          "delayBeforeMs": 1500,
          "expectStatus": 200
        }
      ],
      "expect": {
        "exits": false
      }
    },
    {
      "name": "design folder that cannot be created gives 500 and the server keeps running",
      "setup": {
        "readonlyProject": true
      },
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": "@bundle",
          "expectStatus": 500
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "a link planted inside design is never followed or replaced",
      "setup": {
        "files": {
          "design/keep.txt": "x"
        },
        "symlinks": {
          "design/DESIGN.md": "../../outside/target.md"
        }
      },
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": "@bundle",
          "expectStatus": 409
        }
      ],
      "expect": {
        "absent": [
          "../outside/target.md"
        ],
        "exits": false
      }
    },
    {
      "name": "request from another site (foreign Origin) is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "https://evil.example",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": "@bundle",
          "expectStatus": 403
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "foreign Host header (DNS rebinding) is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Host": "evil.example",
            "Content-Type": "application/json",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": "@bundle",
          "expectStatus": 403
        },
        {
          "method": "GET",
          "path": "/",
          "headers": {
            "Host": "evil.example"
          },
          "expectStatus": 403
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "existing design files are never replaced",
      "setup": {
