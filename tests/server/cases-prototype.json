    {
      "name": "existing design files are never replaced",
      "setup": {
        "files": {
          "design/DESIGN.md": "OLD CONTENT\n"
        }
      },
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": {
            "files": {
              "identity.json": "@identity",
              "DESIGN.md": "@design"
            }
