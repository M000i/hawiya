      "expect": {
        "files": {
          "design/DESIGN.md": "OLD CONTENT\n"
        },
        "absent": [
          "design/identity.json"
        ],
        "exits": false
      }
    },
    {
      "name": "design folder that is a link to outside the project is refused",
      "setup": {
        "symlinks": {
          "design": "../outside"
        }
      },
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": {
            "files": {
              "identity.json": "@identity"
            }
          },
          "expectStatus": 409
        }
      ],
      "expect": {
        "absent": [
          "../outside/identity.json"
        ],
        "exits": false
      }
    },
    {
      "name": "the picker page is served",
      "requests": [
        {
          "method": "GET",
          "path": "/",
          "expectStatus": 200,
          "expectBodyContains": "Hawiya"
        }
      ],
      "expect": {
        "exits": false
      }
    },
    {
      "name": "files outside the picker folder are not served",
      "requests": [
        {
          "method": "GET",
          "path": "/../package.json",
          "expectStatus": 404
        },
        {
          "method": "GET",
          "path": "/%2e%2e/package.json",
          "expectStatus": 404
        },
        {
          "method": "GET",
          "path": "/..%2fpackage.json",
          "expectStatus": 404
        },
        {
          "method": "GET",
          "path": "/%2e%2e%2f%2e%2e%2fetc%2fpasswd",
          "expectStatus": 404
        }
      ],
      "expect": {
        "exits": false
      }
    },
    {
      "name": "wrong method on the export route is rejected",
      "requests": [
        {
          "method": "GET",
          "path": "/api/export",
          "expectStatus": 405
        },
        {
          "method": "OPTIONS",
          "path": "/api/export",
          "headers": {
            "Origin": "https://evil.example"
          },
          "expectStatus": 405
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "idle server closes itself with code 1",
      "args": [
        "--idle-timeout",
        "1"
      ],
      "requests": [],
      "expect": {
        "exits": true,
        "exitCode": 1,
        "stdoutStatus": "closed"
      }
    }
  ]
}
