{
  "about": "FROZEN copy of the phase-0 prototype cases, used only by the Python prototype server until task 1.14. Shared, language-neutral cases for the save server. Run against scripts/serve.js (task 0.4) and scripts/serve.py (task 0.5). Placeholders: {TOKEN} valid token, {ORIGIN} http://127.0.0.1:<port>. Paths in setup/expect are relative to the project dir; '../outside' is a sibling dir outside the project. Request flags: chunked = send body without Content-Length; hold = chunked body (no Content-Length), send a little, never finish; reset = send the request then reset the TCP connection without reading the reply; delayBeforeMs = wait before sending; smuggle = refused POST whose body is a full GET request, exactly one response allowed; raw = exact bytes sent on a socket ({HOST}, {TOKEN}, {LEN_INNER} filled in), expectStatus null = no reply bytes at all, omitted = any, maxResponses = cap on status lines, expectNotContains = text that must not appear in the reply; any raw reply must start with an HTTP status line. Case flag closeStdoutAfterReady = the test stops reading the server's output after the ready line. setup.readonlyProject = make the project dir read-only.",
  "fixtures": {
    "identity": "{\n  \"schemaVersion\": \"0.1-prototype\",\n  \"name\": \"T\"\n}\n",
    "design": "---\nversion: alpha\nname: \"T\"\ncolors:\n  primary: \"#2563eb\"\n---\n\n# T\n"
  },
  "cases": [
    {
      "name": "save succeeds: both files written, server closes with code 0",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": {
            "files": {
              "identity.json": "@identity",
              "DESIGN.md": "@design"
            }
          },
          "expectStatus": 200
        }
      ],
      "expect": {
        "files": {
          "design/identity.json": "@identity",
          "design/DESIGN.md": "@design"
        },
        "exits": true,
        "exitCode": 0,
        "stdoutStatus": "saved"
      }
    },
    {
      "name": "save works without an Origin header (agent or curl, valid token)",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "X-Hawiya-Token": "{TOKEN}"
          },
          "body": {
            "files": {
              "DESIGN.md": "@design"
            }
          },
          "expectStatus": 200
        }
      ],
      "expect": {
        "files": {
          "design/DESIGN.md": "@design"
        },
        "absent": [
          "design/identity.json"
        ],
        "exits": true,
        "exitCode": 0
      }
    },
    {
      "name": "wrong token is rejected and nothing is written",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "not-the-token"
          },
          "body": {
            "files": {
              "identity.json": "@identity"
            }
          },
          "expectStatus": 401
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "missing token is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}"
          },
          "body": {
            "files": {
              "identity.json": "@identity"
            }
          },
          "expectStatus": 401
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "token in the query string is not accepted",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export?token={TOKEN}",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}"
          },
          "body": {
            "files": {
              "identity.json": "@identity"
            }
          },
          "expectStatus": 401
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": false
      }
    },
    {
      "name": "five wrong tokens close the server with code 1",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "application/json",
            "Origin": "{ORIGIN}",
            "X-Hawiya-Token": "wrong"
          },
          "body": {
            "files": {
              "identity.json": "@identity"
            }
          },
          "repeat": 5,
          "expectStatus": 401
        }
      ],
      "expect": {
        "absent": [
          "design"
        ],
        "exits": true,
        "exitCode": 1,
        "stdoutStatus": "closed"
      }
    },
    {
      "name": "file name outside the allowed list is rejected",
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
