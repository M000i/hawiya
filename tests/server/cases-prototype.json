    {
      "name": "requests with a foreign Host do not keep an idle server alive",
      "args": [
        "--idle-timeout",
        "2"
      ],
      "requests": [
        {
          "method": "GET",
          "path": "/",
          "headers": {
            "Host": "evil.example"
          },
          "delayBeforeMs": 1500,
          "expectStatus": 403
        }
      ],
      "expect": {
        "exits": true,
        "exitCode": 1,
        "exitsWithinMsOfReady": 2800,
        "stdoutStatus": "closed"
      }
    },
    {
      "name": "export attempts from another site do not keep an idle server alive",
      "args": [
        "--idle-timeout",
        "2"
      ],
      "requests": [
        {
          "method": "POST",
          "path": "/api/export",
          "headers": {
            "Content-Type": "text/plain",
            "Origin": "https://evil.example"
          },
          "bodyRaw": "x",
          "delayBeforeMs": 1500,
          "expectStatus": 403
        }
      ],
      "expect": {
        "exits": true,
        "exitCode": 1,
        "exitsWithinMsOfReady": 2800,
        "stdoutStatus": "closed"
      }
    },
    {
      "name": "page loads marked cross-site do not keep an idle server alive",
      "args": [
        "--idle-timeout",
        "2"
      ],
      "requests": [
        {
          "method": "GET",
          "path": "/",
          "headers": {
            "Sec-Fetch-Site": "cross-site"
          },
          "delayBeforeMs": 1500,
          "expectStatus": 200
        }
      ],
      "expect": {
        "exits": true,
        "exitCode": 1,
        "exitsWithinMsOfReady": 2800,
        "stdoutStatus": "closed"
      }
    },
    {
      "name": "a normal page load does keep the server alive",
      "args": [
        "--idle-timeout",
        "2"
      ],
      "requests": [
        {
          "method": "GET",
          "path": "/",
          "headers": {
            "Sec-Fetch-Site": "none"
          },
          "delayBeforeMs": 1500,
          "expectStatus": 200
        }
      ],
      "expect": {
        "exits": false
      }
    },
