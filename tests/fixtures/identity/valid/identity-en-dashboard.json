    "font": {
      "heading": {
        "latin": "Inter",
        "fallback": [
          "system-ui",
          "sans-serif"
        ]
      },
      "body": {
        "latin": "Inter",
        "fallback": [
          "system-ui",
          "sans-serif"
        ]
      },
      "numerals": {
        "latin": "JetBrains Mono",
        "fallback": [
          "ui-monospace",
          "monospace"
        ]
      },
      "lineHeight": {
        "ar": 1.7,
        "en": 1.5
      }
    },
    "typeScale": {
      "base": 16,
      "ratio": 1.25,
      "steps": [
        12.8,
        16,
        20,
        25,
        31.25,
        39.06
      ]
    },
    "radius": {
      "sm": 4,
      "md": 8,
      "lg": 12,
      "full": 9999
    },
    "shadow": {
      "light": {
        "sm": [
          {
            "x": 0,
            "y": 1,
            "blur": 2,
            "spread": 0,
            "color": "#000000",
            "alpha": 0.06
          }
        ],
        "md": [
          {
            "x": 0,
            "y": 4,
            "blur": 12,
            "spread": 0,
            "color": "#000000",
            "alpha": 0.08
          }
        ],
        "lg": [
          {
            "x": 0,
            "y": 12,
            "blur": 32,
            "spread": -4,
            "color": "#000000",
            "alpha": 0.12
          },
          {
            "x": 0,
            "y": 2,
            "blur": 4,
            "spread": 0,
            "color": "#000000",
            "alpha": 0.05
          }
        ]
      },
      "dark": {
        "sm": [],
        "md": [
          {
            "x": 0,
            "y": 4,
            "blur": 12,
            "spread": 0,
            "color": "#000000",
            "alpha": 0.6
          }
        ],
        "lg": [
          {
            "x": 0,
            "y": 12,
            "blur": 32,
            "spread": 0,
            "color": "#000000",
            "alpha": 0.7,
            "inset": false
          }
        ]
      }
    },
    "spacing": {
      "unit": 4,
      "scale": [
        0,
        4,
        8,
        12,
        16,
        24,
        32,
        48,
        64
      ]
    }
  },
  "extensions": {
    "icons": {
      "library": "lucide",
      "weight": "regular",
      "fill": "outline",
      "container": "none"
    },
    "components": {
      "button": "button-solid",
      "card": "card-bordered"
    },
    "motion": "subtle",
    "numerals": "latn",
    "calendar": "gregory",
    "rtl": {
      "logicalProperties": true,
      "mirror": [
        "arrow",
        "chevron",
        "undo",
        "redo"
      ],
      "neverMirror": [
        "clock",
        "play",
        "check",
        "media"
      ]
    }
  },
  "selections": {
    "colors": {
      "template": "palette-blue"
    },
    "fonts": {
      "template": "pair-plex-arabic-plex-sans"
    },
    "radius": {
      "template": "radius-soft",
      "overrides": {
        "md": 8
      }
    },
    "buttons": {
      "template": "button-solid",
      "overrides": {
        "label-case": "sentence",
        "full-width": false,
        "icon-gap": 6
      }
    }
  },
  "autoFilled": [
    "shadows",
    "spacing"
  ],
  "leaveToAI": [
    "illustrations",
    "empty-states"
  ]
}
