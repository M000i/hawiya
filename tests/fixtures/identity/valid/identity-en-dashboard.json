        "success": "#15803d",
        "warning": "#b45309",
        "danger": "#b91c1c",
        "info": "#1d4ed8"
      },
      "ramps": {
        "primary": [
          "#eff6ff",
          "#dbeafe",
          "#bfdbfe",
          "#93c5fd",
          "#60a5fa",
          "#3b82f6",
          "#2563eb",
          "#1d4ed8",
          "#1e40af",
          "#1e3a8a",
          "#172554"
        ],
        "secondary": [
          "#f5f3ff",
          "#ede9fe",
